# Copia a env.sh y ejecuta: source local/env.sh
# Variables para Woz (LLM local vía Ollama)

export WOZ_OLLAMA_BASE_URL="${WOZ_OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
export WOZ_MODEL="${WOZ_MODEL:-qwen2.5:7b-instruct}"
export WOZ_TIMEOUT_SECONDS="${WOZ_TIMEOUT_SECONDS:-60}"

